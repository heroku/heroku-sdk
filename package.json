{
  "name": "@heroku/sdk",
  "version": "0.1.0-beta.0",
  "description": "Heroku SDK",
  "author": "Heroku",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/services/platform.d.ts",
      "default": "./dist/services/platform.js"
    },
    "./data": {
      "types": "./dist/services/data.d.ts",
      "default": "./dist/services/data.js"
    },
    "./extensions/platform": {
      "types": "./dist/resources/extensions/platform.d.ts",
      "default": "./dist/resources/extensions/platform.js"
    },
    "./extensions/data": {
      "types": "./dist/resources/extensions/data.d.ts",
      "default": "./dist/resources/extensions/data.js"
    },
    "./resources/*": {
      "types": "./dist/resources/*.d.ts",
      "default": "./dist/resources/*.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/heroku-sdk"
  },
  "scripts": {
    "build": "tsc",
    "coverage": "vitest --run --coverage",
    "example": "tsx",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "npm run build",
    "test": "vitest --run"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@heroku-cli/test-utils": "^0.3.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-oclif": "^6.0.167",
    "eslint-plugin-vitest": "0.5.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@heroku/heroku-fetch": "^0.1.1-beta",
    "@heroku/types": "^3.0.0-beta",
    "debug": "^4.4.0"
  }
}
